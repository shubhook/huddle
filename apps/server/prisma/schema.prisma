// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
// Get a free hosted Postgres database in seconds: `npx create-db`


generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String          @id @default(cuid())
  username               String          @unique
  email                  String          @unique
  hashedPassword         String?
  /// GitHub's numeric user id. Sign-in with GitHub matches on this, never on email alone.
  githubId               String?         @unique
  /// Changes on every upload, so it doubles as the cache key in avatar URLs. Null means no picture.
  avatarId               String?
  createdAt              DateTime        @default(now())

  workspaces             WorkspaceMember[]
  channels               ChannelMember[]
  messages               Message[]
  sentDirectMessages     DirectMessage[] @relation("SentDMs")
  receivedDirectMessages DirectMessage[] @relation("ReceivedDMs")
  sessions               Session[]
  avatar                 UserAvatar?
}

/// The picture bytes live apart from User so that loading a user never drags them along.
/// Always a 128x128 WebP, a few KB, re-encoded on the server whatever was uploaded.
model UserAvatar {
  userId    String   @id
  data      Bytes
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// One row per login. The JWT carries this id as `sid`, and every request checks
/// that the row is still active, so a token can be cancelled before it expires.
model Session {
  id        String    @id @default(uuid())
  userId    String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Workspace {
  id            String            @id @default(cuid())
  name          String
  createdAt     DateTime          @default(now())

  members       WorkspaceMember[]
  channels      Channel[]
  directMessages DirectMessage[]
  invites       WorkspaceInvites[]
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        String    @default("member")
  joinedAt    DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([userId, workspaceId])
}

model Channel {
  id          String          @id @default(cuid())
  name        String
  workspaceId String
  createdAt   DateTime        @default(now())

  workspace   Workspace       @relation(fields: [workspaceId], references: [id])
  members     ChannelMember[]
  messages    Message[]

  @@unique([workspaceId, name])
}

model ChannelMember {
  id        String  @id @default(cuid())
  userId    String
  channelId String

  user      User    @relation(fields: [userId], references: [id])
  channel   Channel @relation(fields: [channelId], references: [id])

  @@unique([userId, channelId])
}

model Message {
  id        String   @id @default(cuid())
  content   String
  senderId  String
  channelId String
  createdAt DateTime @default(now())

  sender    User     @relation(fields: [senderId], references: [id])
  channel   Channel  @relation(fields: [channelId], references: [id])
}

model DirectMessage {
  id          String    @id @default(cuid())
  content     String
  senderId    String
  receiverId  String
  workspaceId String
  createdAt   DateTime  @default(now())

  sender      User      @relation("SentDMs", fields: [senderId], references: [id])
  receiver    User      @relation("ReceivedDMs", fields: [receiverId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
}

model WorkspaceInvites {
  id          String    @id @default(uuid())
  token       String    @unique
  workspaceId String 
  createdId   String
  expiresAt   DateTime

  workspace   Workspace @relation(fields: [workspaceId], references: [id])
}