# Copy to apps/server/.env and fill in values.
# Do not commit real secrets.

# Required for email/password auth + Prisma
# Signs every login token. Use 32+ random characters: openssl rand -base64 48
# With NODE_ENV=production the server refuses to start on a short or example value.
JWT_SECRET=dev-change-me-to-a-long-random-string
DATABASE_URL=postgresql://huddle:huddle@localhost:5432/huddle

# API listen port (default 3000)
PORT=3000

# Comma-separated browser origins allowed for credentialed CORS, the websocket, and any
# request that changes data. A page on any other origin gets 403 on POST/PUT/PATCH/DELETE.
# Web defaults to http://localhost:3008
CLIENT_ORIGIN=http://localhost:3008,http://127.0.0.1:3008

# Set true in production (behind HTTPS). Local HTTP stays false.
# When true, auth + OAuth cookies are sent as SameSite=None; Secure so the
# cross-origin SPA and the GitHub OAuth redirect work in Firefox/Safari too.
COOKIE_SECURE=false

# Optional — GitHub OAuth. Leave blank to use email/password only.
CLIENT_ID=
CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/auth/github/callback

# Optional. Share realtime events between several API processes.
# Leave unset to run a single process. If Redis is unreachable the API still works, one process at a time.
# The Compose file protects Redis with a password: redis://:huddle@localhost:6379
# REDIS_URL=redis://localhost:6379

# Optional websocket timings in milliseconds (defaults shown).
# WS_HEARTBEAT_MS=30000
# WS_MEMBERSHIP_RECHECK_MS=60000

# Behind a reverse proxy or load balancer, set how many proxies sit in front of the API
# (usually 1). Without it every user shares the proxy's IP and the login rate limit would
# lock everyone out together. Leave unset when clients connect directly.
# Do not use "true". It trusts any X-Forwarded-For header and lets attackers pick their IP.
# TRUST_PROXY=1

# Testing only. Turns off login, signup and invite rate limits. Never set this in production.
# RATE_LIMIT_DISABLED=true
